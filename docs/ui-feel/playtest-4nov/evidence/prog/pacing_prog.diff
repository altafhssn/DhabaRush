+def _gaps(times, lo, hi):
+    """Gaps (start, length s) between consecutive times inside [lo, hi], lo and hi included as ends."""
+    ts = sorted(t for t in times if lo - 1e-9 <= t <= hi + 1e-9)
+    pts = [lo] + ts + [hi]
+    return sorted(((pts[i], pts[i + 1] - pts[i]) for i in range(len(pts) - 1)), key=lambda x: -x[1])
 
 
