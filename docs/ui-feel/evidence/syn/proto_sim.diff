+## GA-1 (P0): the bill line is full: ga_cashline a cash counter, counting
+## travellers standing up to go and pay. Travellers who finish eating then wait
+## at their seat to pay (traveller.gd), so the seats - and the gate - fill.
+func ga_bill_full() -> bool:
+	if ga_cashline < 0 or not Game.is_tutorial_done():
+		return false
+	var line: int = 0
+	var n: int = 0
+	for g in gallas:
+		if is_instance_valid(g):
+			n += 1
+			line += int(g.call("queue_length"))
+	for t in travellers:
+		if is_instance_valid(t) and t.state == Traveller.S.STANDING:
+			line += 1
+	return line >= ga_cashline * maxi(1, n)
+
+
+## GA-3 (P4): the dinner rush window (free play only).
+func _ga_in_rush() -> bool:
+	if ga_rush <= 1.0 or not Game.is_tutorial_done():
+		return false
+	var ph: float = float(Game.day_phase)
+	return ph >= ga_rush_from and ph < ga_rush_to
+
