# Dhaba Rush: Highway Idle Tycoon - Hindi (हिंदी) UI translation.
# Little Tag Art Studios. Loaded at runtime by TranslationServer (project.godot
# internationalization/locale/translations); the Loc autoload picks the language.
# Placeholders: %d %s %.1f and {name} must stay; [k]..[/k] / [n]..[/n] = coloured keyword
# in Munshi-ji's lines (a [k] word must be the exact on-screen label). msgctxt "name" =
# a person's name, "unit" = what one sale is called, "title" = a panel title.
# Glossary and review notes: docs/launch/hindi.md.
msgid ""
msgstr ""
"Project-Id-Version: Dhaba Rush 0.3.4\n"
"Language-Team: Little Tag Art Studios\n"
"Language: hi\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n > 1);\n"

# ======================================================================
# Munshi-ji (scripts/v3/tutorial/script_lines.gd, dialogue_box.gd, munshi_notes.gd). [k]..[/k] = a keyword drawn teal/bold: it must be the exact Hindi on-screen label. [n]..[/n] = a new counter (green). {dish} = a dish name. Keep the tags.
# ======================================================================

#. brass name plaque (238 px at 20 px)
msgid "MUNSHI-JI"
msgstr "मुंशी जी"

#. small hint in the dialogue box (200 px at 19 px)
msgid "tap to continue"
msgstr "आगे के लिए टैप करें"

#. chip under the task strip; quotes = the CLAIM button's Hindi label
msgid "Task done! Tap CLAIM"
msgstr "काम पूरा! ‘इनाम लें’ पर टैप करें"

#. first free-play hint chip
msgid "Drag to look around · pinch to zoom"
msgstr "खींचकर चारों ओर देखें · पिंच करके ज़ूम करें"

#. l1: Munshi-ji calls the player 'Seth-ji' (boss) in Hindi
msgid "Namaste, boss! I'm Munshi-ji, your manager. Our dhaba is open!"
msgstr "नमस्ते सेठ जी! मैं मुंशी जी, आपका मैनेजर। अपना ढाबा खुल गया!"

#. l2
msgid "Here comes our first traveller!"
msgstr "लो, आ गया हमारा पहला मुसाफ़िर!"

#. l3: phrased so Pinky's gender never shows (verb agrees with chai)
msgid "[k]Pinky[/k], our cook, makes his chai. [k]Raju[/k], our waiter, carries it."
msgstr "चाय बनेगी कुक [k]पिंकी[/k] के हाथों, पहुँचाएगा वेटर [k]राजू[/k]।"

#. l4: galla = the cash box
msgid "All done! Now he pays at the [k]CASH COUNTER[/k], our galla."
msgstr "खाना ख़त्म! अब वह [k]कैश काउंटर[/k] यानी गल्ले पर पैसे देगा।"

#. l5
msgid "First sale! Your cash is up here, top left."
msgstr "पहली कमाई! आपका कैश यहाँ ऊपर, बाईं ओर है।"

#. l6
msgid "Let's earn more per cup. Tap the [k]CHAI COUNTER[/k]."
msgstr "चलिए, हर कप पर ज़्यादा कमाएँ। [k]चाय काउंटर[/k] पर टैप करें।"

#. l7
msgid "Nice! Every cup now [k]sells for more[/k]."
msgstr "बढ़िया! अब हर कप [k]ज़्यादा दाम[/k] में बिकेगा।"

#. l8
msgid "Oh no! The line at the [k]CASH COUNTER[/k] is too long."
msgstr "अरे बाप रे! [k]कैश काउंटर[/k] पर लाइन बहुत लंबी है।"

#. l9: रखें = the HIRE button
msgid "Tap the [k]CASH COUNTER[/k] and [k]HIRE[/k] a second cashier."
msgstr "[k]कैश काउंटर[/k] पर टैप करें और दूसरा कैशियर [k]रखें[/k]।"

#. l10
msgid "Two cashiers, half the wait! All your staff are in [k]STAFF[/k]."
msgstr "दो कैशियर, आधा इंतज़ार! आपका सारा स्टाफ़ [k]स्टाफ़[/k] बटन में है।"

#. lw1
msgid "Food is waiting! [k]Raju[/k] can't carry it all."
msgstr "खाना रुका पड़ा है! अकेला [k]राजू[/k] सब नहीं ले जा पा रहा।"

#. lw2
msgid "Tap [k]STAFF[/k] and [k]HIRE[/k] a second waiter."
msgstr "[k]स्टाफ़[/k] पर टैप करें और दूसरा वेटर [k]रखें[/k]।"

#. lw3
msgid "Two waiters: food reaches the tables faster."
msgstr "दो वेटर: टेबल पर खाना जल्दी आएगा।"

#. lt1
msgid "Every seat is taken, and travellers are leaving!"
msgstr "सारी सीटें भरी हैं! मुसाफ़िर बिना खाए लौट रहे हैं!"

#. lt2: the tag says '+ टेबल'
msgid "Tap the new [k]TABLE[/k]: four more seats."
msgstr "नई [k]टेबल[/k] पर टैप करें: चार सीटें और।"

#. l14
msgid "Good news: a company pays us to show its ads!"
msgstr "ख़ुशख़बरी! एक कंपनी अपने ऐड दिखाने के हमें पैसे देगी!"

#. l15: the bubble says 'ऐड देखें'
msgid "Whenever the [k]AD[/k] bubble pops up, tap it for free cash."
msgstr "जब भी [k]ऐड[/k] वाला बुलबुला दिखे, टैप करें और मुफ़्त कैश पाएँ।"

#. l16: बनाएँ = the BUILD button
msgid "We can afford a [n]TANDOOR[/n] now. Tap [k]BUILD[/k]."
msgstr "अब हम [n]तंदूर[/n] लगा सकते हैं। [k]बनाएँ[/k] पर टैप करें।"

#. l17
msgid "Roti + chai = a bigger bill! Next goal: a [n]LASSI[/n] counter."
msgstr "रोटी + चाय = बड़ा बिल! अगला लक्ष्य: [n]लस्सी[/n] काउंटर।"

#. free play
msgid "We can afford a [n]LASSI[/n] counter! Tap [k]BUILD[/k]."
msgstr "अब हम [n]लस्सी[/n] काउंटर लगा सकते हैं! [k]बनाएँ[/k] पर टैप करें।"

#. free play
msgid "We can afford a [n]KADAI[/n] now! Tap [k]BUILD[/k]."
msgstr "अब हम [n]कड़ाही[/n] लगा सकते हैं! [k]बनाएँ[/k] पर टैप करें।"

#. free play
msgid "Lassi needs 2 waiters. Tap [k]STAFF[/k] and [k]HIRE[/k] one."
msgstr "लस्सी के लिए 2 वेटर चाहिए। [k]स्टाफ़[/k] पर टैप करें और एक [k]रखें[/k]।"

#. free play
msgid "Kadai needs 3 waiters. Tap [k]STAFF[/k] and [k]HIRE[/k] one."
msgstr "कड़ाही के लिए 3 वेटर चाहिए। [k]स्टाफ़[/k] पर टैप करें और एक [k]रखें[/k]।"

#. free play; phrased so neither Pinky's nor the dish's gender shows
msgid "Pinky, our chai cook, now makes [n]{dish}[/n]. Chai prices rise!"
msgstr "चाय कुक पिंकी के मेन्यू में अब [n]{dish}[/n] भी है। चाय के दाम बढ़ गए!"

#. free play
msgid "Balwant, our tandoor cook, now makes [n]{dish}[/n]. Tandoor prices rise!"
msgstr "तंदूर कुक बलवंत के मेन्यू में अब [n]{dish}[/n] भी है। तंदूर के दाम बढ़ गए!"

#. free play
msgid "Gopi, our lassi maker, now makes [n]{dish}[/n]. Lassi prices rise!"
msgstr "लस्सी वाले गोपी के मेन्यू में अब [n]{dish}[/n] भी है। लस्सी के दाम बढ़ गए!"

#. free play
msgid "Shera, our kadai cook, now makes [n]{dish}[/n]. Kadai prices rise!"
msgstr "कड़ाही कुक शेरा के मेन्यू में अब [n]{dish}[/n] भी है। कड़ाही के दाम बढ़ गए!"

#. once, after an old save moved to the new prices
msgid "New prices! Your levels, staff and dishes are all kept."
msgstr "नए दाम! आपके लेवल, स्टाफ़ और डिश, सब वैसे ही हैं।"

# ======================================================================
# HUD (scripts/v3/ui/hud.gd, ui_root.gd)
# ======================================================================

#. after the cash rate in the money pill (keep the leading space)
msgid " /min"
msgstr " /मिनट"

#. button that brings the camera back to the dhaba
msgid "HOME"
msgstr "होम"

#. floating text when Munshi-ji tops up your cash
msgid "+%s from Munshi-ji"
msgstr "मुंशी जी से +%s"

#. toast
msgid "Chest opened! +%s cash"
msgstr "पेटी खुली! +%s कैश"

#. toast
msgid "Finish tasks to fill the chest (%d/%d)"
msgstr "पेटी भरने के लिए काम पूरे करें (%d/%d)"

#. floating text after a quick hire
msgid "+1 WAITER"
msgstr "+1 वेटर"

#. label at the left of the task strip
msgid "TASK"
msgstr "काम"

#. gold button on a finished task (~100 px at 25 px)
msgid "CLAIM"
msgstr "इनाम लें"

#. NEXT chip headline: travellers waiting at the door for a seat
msgid "PROBLEM · %d WAITING"
msgstr "दिक़्क़त · %d रुके हैं"

#. NEXT chip line 2 (25 px, shrinks to 20)
msgid "Seats full · Build a table"
msgstr "सीटें फ़ुल · टेबल बनाएँ"

#. NEXT chip headline, %s = counter
msgid "NEXT: %s"
msgstr "अगला: %s"

msgid "Hire waiter %d"
msgstr "वेटर %d रखें"

msgid "PROBLEM · FOOD WAITING"
msgstr "दिक़्क़त · खाना रुका है"

msgid "Hire a waiter"
msgstr "एक वेटर रखें"

msgid "Upgrade your waiters"
msgstr "अपने वेटर अपग्रेड करें"

msgid "PROBLEM · LONG BILL LINE"
msgstr "दिक़्क़त · बिल की लंबी लाइन"

msgid "Hire cashier %d"
msgstr "कैशियर %d रखें"

msgid "Upgrade a cashier"
msgstr "एक कैशियर अपग्रेड करें"

msgid "BUILD {name} · {cost}"
msgstr "{name} बनाएँ · {cost}"

#. saving up for the next build: 'Save 197 / 2,000'
msgid "Save %s / %s"
msgstr "पैसे जोड़ें %s / %s"

#. NEXT chip line 2, endless goal once every counter is built (soft launch):
#. a dish milestone or a level milestone, 'LEVEL UP KADAI · 18/25'
msgid "LEVEL UP {name} · {lv}/{target}"
msgstr "{name} लेवल अप · {lv}/{target}"

#. price tag over the next ghost table (16 px)
msgid "ADD TABLE"
msgstr "टेबल जोड़ें"

#. tag over the next waiter's spot
msgid "+ WAITER"
msgstr "+ वेटर"

#. tag over the next ghost table; tutorial keyword TABLE
msgid "+ TABLE"
msgstr "+ टेबल"

#. build pad tag, small second line
msgid "needs waiter %d"
msgstr "वेटर %d चाहिए"

#. build pad tag, %s = counter name
msgid "BUILD %s"
msgstr "%s बनाएँ"

#. pill over the tray rack
msgid "WAITERS %d/%d"
msgstr "वेटर %d/%d"

#. pill over the door
msgid "Seats full!"
msgstr "सीटें फ़ुल!"

#. countdown on the ad bubble: '12s'
msgid "%ds"
msgstr "%d से॰"

#. pop card over a counter when a dish unlocks (15 px)
msgid "NEW ON THE MENU"
msgstr "मेन्यू में नया"

#. 3D pop over a traveller who finds no seat (scripts/v3/world/sim.gd; Label3D auto-translates)
msgid "No seat!"
msgstr "सीट नहीं!"

# ======================================================================
# Settings (scripts/v3/ui/settings_popup.gd)
# ======================================================================

#. popup title
msgid "SETTINGS"
msgstr "सेटिंग्स"

msgid "MUSIC"
msgstr "म्यूज़िक"

msgid "SOUND"
msgstr "साउंड"

msgid "VIBRATION"
msgstr "वाइब्रेशन"

#. toggle: 12,34,567 grouping and lakh / crore
msgid "INDIAN NUMBERS"
msgstr "लाख-करोड़ गिनती"

#. bilingual on purpose: a player can always find it
msgid "LANGUAGE / भाषा"
msgstr "भाषा / LANGUAGE"

#. toggle state
msgid "ON"
msgstr "चालू"

#. toggle state
msgid "OFF"
msgstr "बंद"

#. Settings row: graphics quality (button cycles AUTO / HIGH / LOW)
msgid "GRAPHICS"
msgstr "ग्राफ़िक्स"

#. graphics quality: chosen by the phone (160 px button at 26 px)
msgid "AUTO"
msgstr "ऑटो"

#. graphics quality: full look
msgid "HIGH"
msgstr "हाई"

#. graphics quality: lighter, for cheap phones
msgid "LOW"
msgstr "लो"

#. purchase button
msgid "REMOVE ADS"
msgstr "ऐड हटाएँ"

#. after Remove Ads was bought
msgid "No ads. Thank you!"
msgstr "अब कोई ऐड नहीं। शुक्रिया!"

msgid "SKIP TUTORIAL"
msgstr "ट्यूटोरियल छोड़ें"

msgid "TAP AGAIN TO SKIP"
msgstr "छोड़ने के लिए फिर टैप करें"

#. Settings row (consent track, F1): GameAnalytics on / off; same transliteration style as म्यूज़िक, ग्राफ़िक्स (330 px at 28 px). Also named in the consent card's last line.
msgid "ANALYTICS"
msgstr "एनालिटिक्स"

#. small line under the ANALYTICS row label (340 px at 17 px)
msgid "Helps us improve the game"
msgstr "गेम बेहतर बनाने में मदद"

#. small tappable line above the version in Settings (F4); %s = the random Player ID, e.g. 3F9C-A12B-77DE-0B41 (keep %s; about 560 px at 18 px)
msgid "Player ID: %s · tap to copy"
msgstr "प्लेयर आईडी: %s · कॉपी के लिए टैप करें"

#. toast after the Player ID line was tapped (the id is now on the clipboard)
msgid "Player ID copied."
msgstr "प्लेयर आईडी कॉपी हो गई।"

# ======================================================================
# Ads, purchases, consent (launch SDKs: scripts/v3/ui/settings_popup.gd buttons, scripts/v3/ui/sdk_notice.gd toasts).
# Google's own consent / privacy form and the Play / App Store payment sheets are shown by Google / Apple in the phone's language.
# ======================================================================

#. Settings button, shown only where Google's consent rules apply (EEA / UK); opens Google's own privacy form (24 px, 440 px button)
msgid "PRIVACY OPTIONS"
msgstr "प्राइवेसी विकल्प"

#. Settings button, iPhone only (App Store rule): gets back VIP / No Ads bought earlier (24 px, 440 px button)
msgid "RESTORE PURCHASES"
msgstr "खरीदारी वापस लाएँ"

#. the same button while the store answers
msgid "RESTORING…"
msgstr "वापस ला रहे हैं…"

#. underlined link at the bottom of Settings (opens the privacy policy web page)
msgid "Privacy policy"
msgstr "प्राइवेसी पॉलिसी"

#. toast: a rewarded ad was tapped while another full-screen ad is open
msgid "Another ad is still open."
msgstr "एक ऐड अभी खुला है।"

#. toast: ads wait for the player's answer to Google's consent form
msgid "Ads are paused until you answer the privacy question."
msgstr "प्राइवेसी वाले सवाल का जवाब देने तक ऐड रुके हुए हैं।"

#. toast: this build has no ad SDK (should not happen in a store build)
msgid "Ads are not available on this device."
msgstr "इस डिवाइस पर ऐड उपलब्ध नहीं हैं।"

#. toast: WATCH AD / COLLECT x2 tapped while no ad is loaded (loading, no fill or offline)
msgid "No ad available right now. Try again in a minute."
msgstr "अभी कोई ऐड नहीं है। एक मिनट बाद फिर कोशिश करें।"

#. toast: the rewarded ad was closed before its end, so no reward
msgid "Watch the ad to the end to get the reward."
msgstr "इनाम पाने के लिए ऐड आख़िर तक देखें।"

#. toast: the ad SDK failed to show the ad
msgid "The ad could not play. Please try again."
msgstr "ऐड नहीं चल पाया। कृपया फिर कोशिश करें।"

#. toast: slow payment (e.g. UPI, cash) still processing; the item is granted automatically later
msgid "Payment pending. You will get it as soon as the payment goes through."
msgstr "पेमेंट अभी बाकी है। पेमेंट पूरा होते ही आपको मिल जाएगा।"

#. toast: a pending payment completed and the item was granted
msgid "Payment received. Thank you!"
msgstr "पेमेंट मिल गया। शुक्रिया!"

#. toast: earlier purchases (VIP, No Ads) were found again (reinstall, new phone, RESTORE PURCHASES)
msgid "Purchases restored."
msgstr "खरीदारी वापस मिल गई।"

#. toast: the player closed the store's payment sheet
msgid "Purchase cancelled."
msgstr "खरीदारी रद्द हो गई।"

#. toast: the store reported an error (card declined ...)
msgid "Purchase failed. Please try again."
msgstr "खरीदारी नहीं हो पाई। कृपया फिर कोशिश करें।"

#. toast: no store / billing service / network, or the store never answered
msgid "The store is not available right now. Please try again later."
msgstr "स्टोर अभी उपलब्ध नहीं है। कृपया थोड़ी देर बाद कोशिश करें।"

#. toast: a second purchase tapped while one is running
msgid "Please wait, a purchase is still in progress."
msgstr "कृपया रुकें, एक खरीदारी अभी चल रही है।"

#. toast: RESTORE PURCHASES got no answer from the store
msgid "Could not reach the store. Please try again later."
msgstr "स्टोर से जुड़ नहीं पाए। कृपया थोड़ी देर बाद कोशिश करें।"

#. toast: RESTORE PURCHASES found nothing bought on this account
msgid "Nothing to restore."
msgstr "वापस लाने के लिए कोई खरीदारी नहीं मिली।"

#. toast: PRIVACY OPTIONS could not open Google's form
msgid "Privacy options could not open. Please try again later."
msgstr "प्राइवेसी विकल्प नहीं खुल पाए। कृपया थोड़ी देर बाद कोशिश करें।"

#. toast: the privacy policy link could not be opened (no browser)
msgid "Could not open the privacy policy."
msgstr "प्राइवेसी पॉलिसी नहीं खुल पाई।"

#. toast: an unfinished TASK card was tapped whose task counts up by itself (serve, earn, bill, seat; scripts/v3/ui/ui_root.gd)
msgid "This task fills up as you play."
msgstr "यह काम खेलते-खेलते अपने-आप पूरा होगा।"

#. quit question title: Android back with nothing to close (scripts/v3/ui/quit_popup.gd; 560 px at 32 px)
msgid "LEAVE THE DHABA?"
msgstr "ढाबा छोड़कर जाएँ?"

#. quit question line after the tutorial (offline pay: from 10 min away, 2 h cap; 480 px, 3 lines at 23 px)
msgid "Your staff keep earning while you are away (from 10 min, up to 2 h)."
msgstr "आपके पीछे भी स्टाफ़ कमाई करता रहेगा (10 मिनट बाद से, 2 घंटे तक)।"

#. quit question line during the tutorial (no offline pay yet; the game is saved)
msgid "Your progress is saved. See you soon!"
msgstr "आपका खेल सेव हो गया है। जल्दी मिलते हैं!"

#. quit question: the main button, back to the game (230 px at 30 px)
msgid "STAY"
msgstr "रुकें"

#. quit question: leave the app (230 px at 30 px)
msgid "LEAVE"
msgstr "बाहर जाएँ"

# ======================================================================
# Analytics consent card (scripts/v3/ui/consent_card.gd): shown once on first launch, before GameAnalytics starts (docs/legal/checks.md F1). Plain words; keep "GameAnalytics" in Latin (company name). Lines must match the privacy policy's Hindi summary (docs/legal/privacy-policy.html section 18).
# ======================================================================

#. consent card title (white on maroon, 528 px at 32 px)
msgid "HELP US IMPROVE"
msgstr "गेम बेहतर बनाने में मदद करें"

#. consent card, first paragraph (bold, 388 px wide at 23 px, beside the ledger icon)
msgid "Can we send game statistics to GameAnalytics? They show us how the dhaba is played, so we can fix problems and balance the game."
msgstr "क्या हम गेम के आँकड़े GameAnalytics को भेज सकते हैं? इनसे हमें पता चलता है कि ढाबा कैसे खेला जा रहा है, ताकि हम गड़बड़ियाँ ठीक कर सकें और गेम का संतुलन सुधार सकें।"

#. consent card, what is sent (488 px at 19 px); "advertising ID" = विज्ञापन आईडी as in the privacy policy
msgid "Sent: what you do in the game, phone model, country, a random Player ID and, if your phone allows it, the advertising ID. Never your name, contacts or exact location."
