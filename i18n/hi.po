# Dhaba Rush: Highway Idle Tycoon - Hindi (हिंदी) UI translation.
# Little Tag Art Studios. Loaded at runtime by TranslationServer (project.godot
# internationalization/locale/translations); the Loc autoload picks the language.
# Placeholders: %d %s %.1f and {name} must stay; [k]..[/k] / [n]..[/n] = coloured keyword
# in Munshi-ji's lines (a [k] word must be the exact on-screen label). msgctxt "name" =
# a person's name, "unit" = what one sale is called, "title" = a panel title.
# Glossary and review notes: docs/launch/hindi.md.
msgid ""
msgstr ""
"Project-Id-Version: Dhaba Rush 0.3.4\n"
"Language-Team: Little Tag Art Studios\n"
"Language: hi\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n > 1);\n"

# ======================================================================
# Munshi-ji (scripts/v3/tutorial/script_lines.gd, dialogue_box.gd, munshi_notes.gd). [k]..[/k] = a keyword drawn teal/bold: it must be the exact Hindi on-screen label. [n]..[/n] = a new counter (green). {dish} = a dish name. Keep the tags.
# ======================================================================

#. brass name plaque (238 px at 20 px)
msgid "MUNSHI-JI"
msgstr "मुंशी जी"

#. small hint in the dialogue box (200 px at 19 px)
msgid "tap to continue"
msgstr "आगे के लिए टैप करें"

#. chip under the task strip; quotes = the CLAIM button's Hindi label
msgid "Task done! Tap CLAIM"
msgstr "काम पूरा! ‘इनाम लें’ पर टैप करें"

#. first free-play hint chip
msgid "Drag to look around · pinch to zoom"
msgstr "खींचकर चारों ओर देखें · पिंच करके ज़ूम करें"

#. l1: Munshi-ji calls the player 'Seth-ji' (boss) in Hindi
msgid "Namaste, boss! I'm Munshi-ji, your manager. Our dhaba is open!"
msgstr "नमस्ते सेठ जी! मैं मुंशी जी, आपका मैनेजर। अपना ढाबा खुल गया!"

#. l2
msgid "Here comes our first traveller!"
msgstr "लो, आ गया हमारा पहला मुसाफ़िर!"

#. l3: the player's job (C4.2); subjunctive पकाए / परोसे, so Pinky's gender never shows; no 'है,' (Rect2i quirk, hindi.md); at most ~62 characters, so it is typed 0.12 s before the autopilot's 2.8 s dwell (main3 AUTO_DWELL)
#. REVIEW C4.2
msgid "[k]Pinky[/k] cooks, [k]Raju[/k] serves. Your job: fix what's slow."
msgstr "[k]पिंकी[/k] पकाए, [k]राजू[/k] परोसे। आपका काम: जो धीमा हो, उसे ठीक करें।"

#. l4: galla = the cash box
msgid "All done! Now he pays at the [k]CASH COUNTER[/k], our galla."
msgstr "खाना ख़त्म! अब वह [k]कैश काउंटर[/k] यानी गल्ले पर पैसे देगा।"

#. l5
msgid "First sale! Your cash is up here, top left."
msgstr "पहली कमाई! आपका कैश यहाँ ऊपर, बाईं ओर है।"

#. l6
msgid "Let's earn more per cup. Tap the [k]CHAI COUNTER[/k]."
msgstr "चलिए, हर कप पर ज़्यादा कमाएँ। [k]चाय काउंटर[/k] पर टैप करें।"

#. l7
msgid "Nice! Every cup now [k]sells for more[/k]."
msgstr "बढ़िया! अब हर कप [k]ज़्यादा दाम[/k] में बिकेगा।"

#. l8
msgid "Oh no! The line at the [k]CASH COUNTER[/k] is too long."
msgstr "अरे बाप रे! [k]कैश काउंटर[/k] पर लाइन बहुत लंबी है।"

#. l9: रखें = the HIRE button
msgid "Tap the [k]CASH COUNTER[/k] and [k]HIRE[/k] a second cashier."
msgstr "[k]कैश काउंटर[/k] पर टैप करें और दूसरा कैशियर [k]रखें[/k]।"

#. l10
msgid "Two cashiers, half the wait! All your staff are in [k]STAFF[/k]."
msgstr "दो कैशियर, आधा इंतज़ार! आपका सारा स्टाफ़ [k]स्टाफ़[/k] बटन में है।"

#. lw1
msgid "Food is waiting! [k]Raju[/k] can't carry it all."
msgstr "खाना रुका पड़ा है! अकेला [k]राजू[/k] सब नहीं ले जा पा रहा।"

#. lw2: वेटर = the new waiter's tag '+ वेटर', रखें = the HIRE button of his card (C3.1)
#. REVIEW C3.1
msgid "Tap the new [k]WAITER[/k], then [k]HIRE[/k]."
msgstr "नए [k]वेटर[/k] पर टैप करें, फिर उसे [k]रखें[/k]।"

#. lw3
msgid "Two waiters: food reaches the tables faster."
msgstr "दो वेटर: टेबल पर खाना जल्दी आएगा।"

#. lt1: the door line waits for a seat now; nobody leaves (C2.1)
#. REVIEW C2.1
msgid "Every seat is taken! Travellers wait at the gate."
msgstr "सारी सीटें भरी हैं! मुसाफ़िर गेट पर इंतज़ार कर रहे हैं।"

#. lt2: the tag says '+ टेबल'
msgid "Tap the new [k]TABLE[/k]: four more seats."
msgstr "नई [k]टेबल[/k] पर टैप करें: चार सीटें और।"

#. l14: no 'pays us', no 'cash' (C7.5); ऐड = the bubble's 'ऐड देखें'
#. REVIEW C7.5
msgid "Good news: watch a short [k]AD[/k] for a bonus!"
msgstr "ख़ुशख़बरी! एक छोटा [k]ऐड[/k] देखें और बोनस पाएँ!"

#. l15: the bubble says 'ऐड देखें' (C7.5)
#. REVIEW C7.5
msgid "When the [k]AD[/k] bubble pops up, tap it for a bonus."
msgstr "जब [k]ऐड[/k] वाला बुलबुला दिखे, उस पर टैप करें और बोनस पाएँ।"

#. l16: बनाएँ = the BUILD button
msgid "We can afford a [n]TANDOOR[/n] now. Tap [k]BUILD[/k]."
msgstr "अब हम [n]तंदूर[/n] लगा सकते हैं। [k]बनाएँ[/k] पर टैप करें।"

#. l17
msgid "Roti + chai = a bigger bill! Next goal: a [n]LASSI[/n] counter."
msgstr "रोटी + चाय = बड़ा बिल! अगला लक्ष्य: [n]लस्सी[/n] काउंटर।"

#. free play
msgid "We can afford a [n]LASSI[/n] counter! Tap [k]BUILD[/k]."
msgstr "अब हम [n]लस्सी[/n] काउंटर लगा सकते हैं! [k]बनाएँ[/k] पर टैप करें।"

#. free play
msgid "We can afford a [n]KADAI[/n] now! Tap [k]BUILD[/k]."
msgstr "अब हम [n]कड़ाही[/n] लगा सकते हैं! [k]बनाएँ[/k] पर टैप करें।"

#. free play (menu_need_waiters_lassi): वेटर = the '+ वेटर' tag, रखें = HIRE (C3.1)
#. REVIEW C3.1
msgid "Lassi needs 2 waiters. Tap the new [k]WAITER[/k] and [k]HIRE[/k]."
msgstr "लस्सी के लिए 2 वेटर चाहिए। नए [k]वेटर[/k] पर टैप करें और उसे [k]रखें[/k]।"

#. free play (menu_need_waiters): वेटर = the '+ वेटर' tag, रखें = HIRE (C3.1)
#. REVIEW C3.1
msgid "Kadai needs 3 waiters. Tap the new [k]WAITER[/k] and [k]HIRE[/k]."
msgstr "कड़ाही के लिए 3 वेटर चाहिए। नए [k]वेटर[/k] पर टैप करें और उसे [k]रखें[/k]।"

#. free play; phrased so neither Pinky's nor the dish's gender shows
msgid "Pinky, our chai cook, now makes [n]{dish}[/n]. Chai prices rise!"
msgstr "चाय कुक पिंकी के मेन्यू में अब [n]{dish}[/n] भी है। चाय के दाम बढ़ गए!"

#. free play
msgid "Balwant, our tandoor cook, now makes [n]{dish}[/n]. Tandoor prices rise!"
msgstr "तंदूर कुक बलवंत के मेन्यू में अब [n]{dish}[/n] भी है। तंदूर के दाम बढ़ गए!"

#. free play
msgid "Gopi, our lassi maker, now makes [n]{dish}[/n]. Lassi prices rise!"
msgstr "लस्सी वाले गोपी के मेन्यू में अब [n]{dish}[/n] भी है। लस्सी के दाम बढ़ गए!"

#. free play
msgid "Shera, our kadai cook, now makes [n]{dish}[/n]. Kadai prices rise!"
msgstr "कड़ाही कुक शेरा के मेन्यू में अब [n]{dish}[/n] भी है। कड़ाही के दाम बढ़ गए!"

#. once, after an old save moved to the new prices
msgid "New prices! Your levels, staff and dishes are all kept."
msgstr "नए दाम! आपके लेवल, स्टाफ़ और डिश, सब वैसे ही हैं।"

#. react_waiters: chip (no box): one or two lines of 20 px in 460 px; after the player's own fix of the waiters (C4.3)
#. REVIEW C4.3
msgid "Shabaash! Food moves faster now."
msgstr "शाबाश! अब खाना तेज़ी से टेबल तक जा रहा है।"

#. react_seats: chip (no box): one or two lines of 20 px in 460 px (C4.3)
#. REVIEW C4.3
msgid "More charpais, more customers. Waah!"
msgstr "ज़्यादा चारपाई, ज़्यादा ग्राहक। वाह!"

#. react_cashiers: chip (no box): one or two lines of 20 px in 460 px (C4.3)
#. REVIEW C4.3
msgid "The galla is quick now. Badhiya!"
msgstr "अब गल्ला फटाफट चल रहा है। बढ़िया!"

#. react_kitchen: chip (no box): one or two lines of 20 px in 460 px (C4.3)
#. REVIEW C4.3
msgid "The kitchen keeps up now. First class!"
msgstr "अब रसोई काम संभाल रही है। फ़र्स्ट क्लास!"

#. react_road: chip (no box): one or two lines of 20 px in 460 px; drivers call a dhaba a 'hotel' (C4.3, C8.2); lorry = ट्रक
#. REVIEW C4.3
#. REVIEW C8.2
msgid "More lorries stopping. Best hotel on the highway!"
msgstr "ज़्यादा ट्रक रुक रहे हैं। हाईवे का सबसे बढ़िया होटल!"

#. react_any_1: chip (no box): one or two lines of 20 px in 460 px; generic pool (C4.3)
#. REVIEW C4.3
#. REVIEW tone
msgid "Ekdum sahi, boss! Good fix."
msgstr "एकदम सही, सेठ जी! बढ़िया सुधार।"

#. react_any_2: chip (no box): one or two lines of 20 px in 460 px; generic pool; the Rajdhani = the fast train, so राजधानी एक्सप्रेस (C4.3, C8.2)
#. REVIEW C4.3
#. REVIEW C8.2
#. REVIEW tone
msgid "Our hotel runs like the Rajdhani now, boss!"
msgstr "सेठ जी, अपना होटल अब राजधानी एक्सप्रेस जैसा दौड़ रहा है!"

#. reno_tease: chip (no box): one or two lines of 20 px in 460 px, ~90 s after the tutorial; बनाएँ = the BUILD button (C5.2)
#. REVIEW C5.2
msgid "One day this becomes a [n]FAMILY DHABA[/n]. See [k]BUILD[/k]."
msgstr "एक दिन यह [n]फ़ैमिली ढाबा[/n] बनेगा। [k]बनाएँ[/k] में देखें।"

#. reno_ready: dialogue with a camera fly to the hall site (C6.1)
#. REVIEW C6.1
msgid "All 16 dishes! The [n]FAMILY DHABA[/n] waits in [k]BUILD[/k]."
msgstr "मेन्यू में सभी 16 डिश! [n]फ़ैमिली ढाबा[/n] [k]बनाएँ[/k] में इंतज़ार कर रहा है।"

#. reno_done: dialogue after the renovation reveal (C6.1)
#. REVIEW C6.1
msgid "The AC family hall is open! It's far: hire more waiters."
msgstr "एसी फ़ैमिली हॉल खुल गया! वह दूर है: और वेटर रखें।"

#. move_ready: dialogue (C6.3)
#. REVIEW C6.3
msgid "A new highway is calling, boss! See [k]BUILD[/k]."
msgstr "सेठ जी, नया हाईवे बुला रहा है! [k]बनाएँ[/k] में देखें।"

#. move_done: dialogue after the move reveal (C6.3); NH 48 stays in Latin letters, as on the milestone; no 'है,' (Rect2i quirk)
#. REVIEW C6.3
msgid "Welcome to NH 48, boss! New road, Rajasthani dishes."
msgstr "NH 48 पर आपका स्वागत, सेठ जी! नई सड़क, राजस्थानी पकवान।"

#. event_start: chip (no box): one or two lines of 20 px in 460 px, once per weekend; बारात = the HUD button's caption (C6.4)
#. REVIEW C6.4
msgid "A baraat is coming this weekend! Tap [k]BARAAT[/k]."
msgstr "इस वीकेंड बारात आ रही है! [k]बारात[/k] पर टैप करें।"

#. delegation_on: chip (no box): one or two lines of 20 px in 460 px; Munshi-ji now claims finished task cards (C6.5)
#. REVIEW C6.5
msgid "Boss, I'll claim finished task cards for you from now on."
msgstr "सेठ जी, अब से पूरे हुए कामों का इनाम मैं आपके लिए ले लूँगा।"

# ======================================================================
# HUD (scripts/v3/ui/hud.gd, ui_root.gd)
# ======================================================================

#. after the cash rate in the money pill (keep the leading space)
msgid " /min"
msgstr " /मिनट"

#. button that brings the camera back to the dhaba
msgid "HOME"
msgstr "होम"

#. floating text when Munshi-ji tops up your cash
msgid "+%s from Munshi-ji"
msgstr "मुंशी जी से +%s"

#. toast
msgid "Chest opened! +%s cash"
msgstr "पेटी खुली! +%s कैश"

#. toast
msgid "Finish tasks to fill the chest (%d/%d)"
msgstr "पेटी भरने के लिए काम पूरे करें (%d/%d)"

#. floating text after a quick hire
msgid "+1 WAITER"
msgstr "+1 वेटर"

#. label at the left of the task strip
msgid "TASK"
msgstr "काम"

#. gold button on a finished task (~100 px at 25 px)
msgid "CLAIM"
msgstr "इनाम लें"

#. NEXT chip headline: travellers waiting at the door for a seat
msgid "PROBLEM · %d WAITING"
msgstr "दिक़्क़त · %d रुके हैं"

#. NEXT chip line 2 (25 px, shrinks to 20)
msgid "Seats full · Build a table"
msgstr "सीटें फ़ुल · टेबल बनाएँ"

#. NEXT chip headline, %s = counter
msgid "NEXT: %s"
msgstr "अगला: %s"

msgid "Hire waiter %d"
msgstr "वेटर %d रखें"

msgid "PROBLEM · FOOD WAITING"
msgstr "दिक़्क़त · खाना रुका है"

msgid "Hire a waiter"
msgstr "एक वेटर रखें"

msgid "Upgrade your waiters"
msgstr "अपने वेटर अपग्रेड करें"

msgid "PROBLEM · LONG BILL LINE"
msgstr "दिक़्क़त · बिल की लंबी लाइन"

msgid "Hire cashier %d"
msgstr "कैशियर %d रखें"

msgid "Upgrade a cashier"
msgstr "एक कैशियर अपग्रेड करें"

msgid "BUILD {name} · {cost}"
msgstr "{name} बनाएँ · {cost}"

#. saving up for the next build: 'Save 197 / 2,000'
msgid "Save %s / %s"
msgstr "पैसे जोड़ें %s / %s"

#. NEXT chip line 2, endless goal once every counter is built (soft launch):
#. a dish milestone or a level milestone, 'LEVEL UP KADAI · 18/25'
msgid "LEVEL UP {name} · {lv}/{target}"
msgstr "{name} लेवल अप · {lv}/{target}"

#. NEXT chip: 'NEXT: %s' (renovation ready or saving); also the BUILD row and the promo popup title (C6.1)
#. REVIEW C6.1
msgid "FAMILY DHABA"
msgstr "फ़ैमिली ढाबा"

#. NEXT chip line 2 (282 px, 25 to 20 px) (C6.1)
#. REVIEW C6.1
msgid "Ready! Tap to renovate"
msgstr "तैयार! टैप करें, नया रूप दें"

#. NEXT chip line 2 while saving for the Family Dhaba or NH 48, and the promo popup's cash reason: the cash still missing (C6.1, C6.3)
#. REVIEW C6.1
msgid "Save {money}"
msgstr "{money} और जोड़ें"

#. location name in 'NEXT: %s' (data/economy_v3.json locations.nh48.name); highway numbers stay Latin, as on the milestone (C6.3)
#. REVIEW C6.3
msgid "NH 48"
msgstr "NH 48"

#. location name (data/economy_v3.json locations.nh44.name; the first highway, never a move target today) (C6.3)
#. REVIEW C6.3
msgid "NH 44"
msgstr "NH 44"

#. NEXT chip line 2 when NH 48 is affordable (C6.3)
#. REVIEW C6.3
msgid "A new highway is ready"
msgstr "नया हाईवे तैयार है"

#. NEXT chip 'NEXT: %s'; the readout's fix label; glossary: signboard = साइनबोर्ड (C5.3)
#. REVIEW C5.3
msgid "SIGNBOARD"
msgstr "साइनबोर्ड"

#. NEXT chip line 2 when the road limits and the signboard pays back (C5.3); same phrasing as the meter caption
#. REVIEW C5.3
msgid "The road is the limit now"
msgstr "अब सड़क ही लिमिट है"

#. NEXT chip seats PROBLEM line 2: what one more table adds (C2.1)
#. REVIEW C2.1
msgid "+{money}/min with one more table"
msgstr "एक और टेबल से +{money}/मिनट"

#. HUD event button caption under the baraat glyph (96 px at 21 px); Munshi-ji's event_start keyword (C6.4)
#. REVIEW C6.4
msgid "BARAAT"
msgstr "बारात"

#. toast after Munshi-ji claimed a finished task card by himself (C6.5)
#. REVIEW C6.5
msgid "Munshi-ji claimed it for you"
msgstr "मुंशी जी ने आपके लिए इनाम ले लिया"

#. float under the money pill when a purchase raises the rate; BUILD signboard row gain; STATS ONE MORE TABLE value (C3.3, C5.3, C2.1)
#. REVIEW C3.3
msgid "+{money}/min"
msgstr "+{money}/मिनट"

#. float over a waiter whose tray grows (C3.4)
#. REVIEW C3.4
msgid "BIGGER TRAY!"
msgstr "बड़ी ट्रे!"

#. price tag over the next ghost table (16 px)
msgid "ADD TABLE"
msgstr "टेबल जोड़ें"

#. tag over the next waiter's spot
msgid "+ WAITER"
msgstr "+ वेटर"

#. tag over the next ghost table; tutorial keyword TABLE
msgid "+ TABLE"
msgstr "+ टेबल"

#. build pad tag, small second line
msgid "needs waiter %d"
msgstr "वेटर %d चाहिए"

#. build pad tag, %s = counter name
msgid "BUILD %s"
msgstr "%s बनाएँ"

#. pill over the tray rack
msgid "WAITERS %d/%d"
msgstr "वेटर %d/%d"

#. pill over the door
msgid "Seats full!"
msgstr "सीटें फ़ुल!"

#. countdown on the ad bubble: '12s'
msgid "%ds"
msgstr "%d से॰"

#. pop card over a counter when a dish unlocks (15 px)
msgid "NEW ON THE MENU"
msgstr "मेन्यू में नया"

#. 3D pop over a traveller who finds no seat (scripts/v3/world/sim.gd; Label3D auto-translates)
msgid "No seat!"
msgstr "सीट नहीं!"

# ======================================================================
# Settings (scripts/v3/ui/settings_popup.gd)
# ======================================================================

#. popup title
msgid "SETTINGS"
msgstr "सेटिंग्स"

msgid "MUSIC"
msgstr "म्यूज़िक"

msgid "SOUND"
msgstr "साउंड"

msgid "VIBRATION"
msgstr "वाइब्रेशन"

#. toggle: 12,34,567 grouping and lakh / crore
msgid "INDIAN NUMBERS"
msgstr "लाख-करोड़ गिनती"

#. bilingual on purpose: a player can always find it
msgid "LANGUAGE / भाषा"
msgstr "भाषा / LANGUAGE"

#. toggle state
msgid "ON"
msgstr "चालू"

#. toggle state
msgid "OFF"
msgstr "बंद"

#. Settings row: graphics quality (button cycles AUTO / HIGH / LOW)
msgid "GRAPHICS"
msgstr "ग्राफ़िक्स"

#. graphics quality: chosen by the phone (160 px button at 26 px)
msgid "AUTO"
msgstr "ऑटो"

#. graphics quality: full look
msgid "HIGH"
msgstr "हाई"

#. graphics quality: lighter, for cheap phones
msgid "LOW"
msgstr "लो"

#. purchase button
msgid "REMOVE ADS"
msgstr "ऐड हटाएँ"

#. after Remove Ads was bought (C7.4: 'no forced ads')
#. REVIEW C7.4
msgid "No forced ads. Thank you!"
msgstr "कोई ज़बरदस्ती का ऐड नहीं। शुक्रिया!"

#. small line under REMOVE ADS (C7.4); same promise as the store listing's 'बोनस वीडियो आपकी मर्ज़ी से'
#. REVIEW C7.4
